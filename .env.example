# Public Supabase project values. Keep actual values in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Public site origin used in QR menu links and share previews.
# Production (Vercel): https://adisyonweb.com  (rebuild after changing it).
# Local development: leave empty or use http://localhost:3000 so QR codes do not point at production.
# Empty = QR links use the request host; share previews default to https://adisyonweb.com.
NEXT_PUBLIC_SITE_URL=
