# Public Supabase project values. Keep actual values in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Public site origin used in QR menu links (e.g. https://app.example.com).
# Falls back to the request host when empty.
NEXT_PUBLIC_SITE_URL=
